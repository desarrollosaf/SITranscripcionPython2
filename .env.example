# =============================================
# API de transcripción – Variables de entorno
# =============================================

# Base de datos MySQL (usuarios/login y registro de trabajos).
# En tu máquina: DB_HOST=host.docker.internal (el MySQL que ya corre en
# Docker en tu equipo). En el servidor: cambia solo este valor por el host
# real de tu MySQL ahí.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=transcripcion_api
DB_USER=root
DB_PASS=root

# Clave para firmar los tokens JWT del login. Genera una larga y aleatoria,
# por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Puerto en el host donde queda expuesta la API (http://localhost:8000)
API_PORT=8000

# Puerto de la interfaz visual de revisión, servicio "revisor"
# (http://localhost:8756)
REVISOR_PORT=8756

# Opcional: para los resúmenes automáticos con IA en revisar.py
ANTHROPIC_API_KEY=

# Rango de puertos UDP para audio SRT entrante (consola de audio / Dante
# Virtual Soundcard empujando en vivo desde otra máquina). Uno por
# transmisión simultánea — con el default (9000-9009) caben 10 comisiones
# al mismo tiempo. Recuerda abrir este rango en el firewall/security group
# de tu proveedor de nube.
SRT_PUERTO_BASE=9000
SRT_PUERTO_FIN=9009

# Si tu servidor no resuelve parlamentario.congresoedomex.gob.mx por DNS
# normal dentro de los contenedores (redes gob.mx con DNS interno
# restringido), pon aquí la IP correcta desde tu red. Déjalo vacío/quítalo
# si tu servidor sí lo resuelve solo.
PARLAMENTARIO_IP=192.168.36.59
